; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="StudentDay"
config/icon="res://assets/icons/app_icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

XRToolsUserSettings="*res://addons/godot-xr-tools/user_settings/user_settings.gd"
XRToolsRumbleManager="*res://addons/godot-xr-tools/rumble/rumble_manager.gd"
GameStateManager="*res://scenes/systems/game_state_manager.tscn"
TimeManager="*res://scenes/systems/time_manager.tscn"
QuestManager="*res://scenes/systems/quest_manager.tscn"
SceneManager="*res://scenes/systems/scene_manager.tscn"
StatisticsManager="*res://scenes/systems/statistics_manager.tscn"
AchievementManager="*res://scenes/systems/achievement_manager.tscn"
RandomEventManager="*res://scenes/systems/random_event_manager.tscn"
SaveManager="*res://scenes/systems/save_manager.tscn"
XrSimulator="*res://scenes/debug/desktop_simulator.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg")

[filesystem]

import/blender/enabled=false

[layer_names]

3d_physics/layer_1="World and objects"
3d_physics/layer_23="VR UI"

[physics]

common/physics_ticks_per_second=90
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
shaders/enabled=true
